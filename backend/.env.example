APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
FRONTEND_URL=http://localhost:3000

# Compte administrateur créé par `php artisan db:seed`.
# Laissez ADMIN_PASSWORD vide pour qu'un mot de passe aléatoire soit généré
# et affiché une seule fois dans la console.
ADMIN_EMAIL=admin@gtech.local
ADMIN_NAME="Administrateur G-Tech"
ADMIN_PHONE="+221 77 000 00 00"
ADMIN_PASSWORD=

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Optional company details printed on invoice PDFs
GTECH_INVOICE_COMPANY_NAME="G-Tech Solution"
GTECH_INVOICE_ADDRESS="Dakar, Sénégal"
GTECH_INVOICE_PHONE=
GTECH_INVOICE_EMAIL=
GTECH_INVOICE_WEBSITE=

# Shop details printed on invoice PDFs (blank values are not printed)
SHOP_ADDRESS="Dakar, Sénégal"
SHOP_PHONE=
SHOP_EMAIL=
SHOP_NINEA=
SHOP_RCCM=

# WhatsApp Business Cloud API (disabled until fully configured)
WHATSAPP_ENABLED=false
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v23.0
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANGUAGE=fr

# Retention and stale-location threshold for delivery GPS data
DELIVERY_LOCATION_RETENTION_DAYS=30
DELIVERY_LOCATION_STALE_MINUTES=5

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
